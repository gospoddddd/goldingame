# Project filesystem access is defined in ../config.toml.
# These rules only govern commands that request execution outside that sandbox.

prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "Project branches may be pushed without another prompt; protected main and required CI remain the enforcement boundary.",
    match = ["git push", "git push --set-upstream origin codex/github-governance"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "ready", "merge"]],
    decision = "allow",
    justification = "The owner authorized autonomous PR lifecycle actions for this repository when checks pass and rollback is practical.",
    match = [
        "gh pr create --draft",
        "gh pr edit 2 --add-label documentation",
        "gh pr ready 2",
        "gh pr merge 2 --squash --delete-branch",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", ["edit", "delete"]],
    decision = "prompt",
    justification = "Repository visibility, governance, or deletion changes still require explicit approval.",
    match = [
        "gh repo edit gospoddddd/goldingame --visibility private",
        "gh repo delete gospoddddd/goldingame",
    ],
)

prefix_rule(
    pattern = [["npm", "pnpm"], "publish"],
    decision = "prompt",
    justification = "Publishing a package is an external production action and requires confirmation.",
    match = ["npm publish", "pnpm publish"],
)

prefix_rule(
    pattern = ["docker", "push"],
    decision = "prompt",
    justification = "Pushing an image changes an external registry and requires confirmation.",
    match = ["docker push registry.example.com/redraft:latest"],
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy"]],
    decision = "prompt",
    justification = "Infrastructure changes require explicit confirmation.",
    match = ["terraform apply", "terraform destroy"],
)

prefix_rule(
    pattern = ["kubectl", ["apply", "delete"]],
    decision = "prompt",
    justification = "Cluster mutations require explicit confirmation.",
    match = ["kubectl apply -f deployment.yaml", "kubectl delete pod redraft"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "System-level elevation is outside this project. Use project-local tooling instead.",
    match = ["sudo npm install", "sudo rm -rf build"],
)

prefix_rule(
    pattern = [["shutdown", "reboot", "halt"]],
    decision = "forbidden",
    justification = "Machine power operations are outside this project.",
    match = ["shutdown -h now", "reboot", "halt"],
)
