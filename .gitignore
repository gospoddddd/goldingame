.DS_Store

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# JavaScript and build output
node_modules/
dist/
build/
.next/
coverage/

# Local caches and logs
*.log
.cache/
.turbo/

# Obsidian machine-specific state
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache/
vault/.trash/

# Raw or licensed datasets must not be committed
data/raw/
data/licensed/

# Python tooling
__pycache__/
*.py[cod]
